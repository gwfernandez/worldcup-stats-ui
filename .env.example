# URL base de la REST API externa (worldcup-stats-service)
# Ejemplo para desarrollo local: http://localhost:8080
# En Vercel, usar same-origin para activar el proxy definido en vercel.ts
VITE_API_BASE_URL=http://localhost:8080

# URL base privada usada por el proxy de Vercel cuando VITE_API_BASE_URL=same-origin
BACKEND_API_BASE_URL=http://localhost:8080/api

# Control de Mocks
# - true: Mantiene mocks solo en los services que aún no consumen el backend
# - false: Deshabilita todos los fallbacks mock disponibles
VITE_USE_MOCK=true
